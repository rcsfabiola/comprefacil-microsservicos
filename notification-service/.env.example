# Usado apenas para rodar o serviço fora do Docker (npm start).
# No docker-compose esses valores já estão definidos.
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db
RABBITMQ_URL=amqp://admin:admin@localhost:5672
EVENTS_EXCHANGE=comprefacil.eventos
NOTIFICATION_QUEUE=notificacoes
BINDING_KEY=transacao.#
MAX_ATTEMPTS=3
RETRY_DELAY_MS=2000
